        <mxCell id="admin_bar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0284C7;strokeWidth=1.5;align=left;spacingLeft=15;" value="&lt;b style=&quot;font-size: 13px; color: #38BDF8;&quot;&gt;PERAN ADMINISTRATOR (TATA KELOLA SISTEM, PENGAWASAN 3 PILAR &amp;amp; AUDIT KEAMANAN RBAC)&lt;/b&gt;&lt;br&gt;&lt;table width=&quot;100%&quot; border=&quot;0&quot; cellpadding=&quot;6&quot; style=&quot;color:#E2E8F0; font-size:11px; margin-top:4px;&quot;&gt;&lt;tr&gt;&lt;td width=&quot;25%&quot;&gt;&lt;b style=&quot;color:#38BDF8;&quot;&gt;1. Manajemen Akun RBAC:&lt;/b&gt;&lt;br&gt;Pemberian hak akses resmi role DMO, QC, SM, dan Procurement.&lt;/td&gt;&lt;td width=&quot;25%&quot;&gt;&lt;b style=&quot;color:#38BDF8;&quot;&gt;2. Mode Impersonasi Sesi:&lt;/b&gt;&lt;br&gt;Audit &amp;amp; supervisi langsung sebagai role user tanpa meminta password.&lt;/td&gt;&lt;td width=&quot;25%&quot;&gt;&lt;b style=&quot;color:#38BDF8;&quot;&gt;3. Period Locking (Kunci Periode):&lt;/b&gt;&lt;br&gt;Mengunci data transaksi bulanan/semester agar tidak bisa dimanipulasi.&lt;/td&gt;&lt;td width=&quot;25%&quot;&gt;&lt;b style=&quot;color:#38BDF8;&quot;&gt;4. Audit Log &amp;amp; Standby Kiosk:&lt;/b&gt;&lt;br&gt;Merekam jejak audit serta display TV Command Center real-time.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
